# Copia este archivo como .env para configurar el frontend.
#
# Déjalo vacío para usar el modo local (sin API): los datos se guardan en el navegador.
# Para conectar con el backend de ASP.NET Core, pon su URL, por ejemplo:
#   VITE_API_URL=http://localhost:5196
# 5196 es el puerto del perfil "http" en backend/SuSu.Api/Properties/launchSettings.json.
VITE_API_URL=
